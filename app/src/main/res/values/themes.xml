<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Locked" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/almost_black</item>
        <item name="android:navigationBarColor">@color/almost_black</item>
        <item name="android:windowBackground">@color/almost_black</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- Used by BlockActivity / MorningActivity: no transition animation so
         the block screen truly appears "immediately" with no visible delay. -->
    <style name="Theme.Locked.Block" parent="Theme.Locked">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>
